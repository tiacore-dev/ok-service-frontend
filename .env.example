# Локальная конфигурация ok-service-frontend.
# Создайте файл .env в корне проекта на основе этого примера.
# npm start запускает фронтенд на http://localhost:8083.
# После изменения REACT_APP_* перезапустите dev-сервер или пересоберите приложение:
# Webpack подставляет значения при сборке. Переменные окружения REACT_APP_*
# процесса имеют приоритет над значениями из .env.
# Клиентские настройки доступны в браузере; серверные ключи сюда не добавляются.

# --- Backend API ---
# Базовый URL API без завершающего слеша.
# Для backend, запущенного через python run.py, используется порт 8000.
# При работе через прокси укажите его полный URL вместе с префиксом API, если он есть.
REACT_APP_API_URL=http://localhost:8000

# --- Firebase Web Push ---
# Для локальной работы без push оставьте весь блок пустым:
# приложение продолжит работать, Firebase Messaging не будет инициализироваться.
# Для push заполните настройки одного и того же Firebase-проекта.
# Docker-сборка требует непустые значения всех семи переменных этого блока.
#
# Первые шесть значений: Firebase Console -> Project settings -> General ->
# Your apps -> Web app -> SDK setup and configuration -> Config.

# Поле apiKey из конфигурации веб-приложения Firebase.
REACT_APP_FIREBASE_API_KEY=

# Поле authDomain из конфигурации (например, your-project.firebaseapp.com).
REACT_APP_FIREBASE_AUTH_DOMAIN=

# Поле projectId: идентификатор проекта, а не его отображаемое имя.
REACT_APP_FIREBASE_PROJECT_ID=

# Поле storageBucket: скопируйте точное значение из конфигурации Firebase.
REACT_APP_FIREBASE_STORAGE_BUCKET=

# Поле messagingSenderId: числовой идентификатор отправителя / номер проекта.
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=

# Поле appId: идентификатор веб-приложения вида 1:123456789:web:abcdef.
REACT_APP_FIREBASE_APP_ID=

# Публичный ключ Web Push (VAPID): Project settings -> Cloud Messaging ->
# Web configuration -> Web Push certificates -> Key pair.
# Для получения push-токена нужен этот публичный ключ, а не приватный ключ.
REACT_APP_FIREBASE_VAPID_KEY=

# --- Совместимость с существующей Docker/CI-конфигурацией ---
# Передаётся как build argument; текущий код фронтенда эту переменную не использует.
REACT_APP_WP=

# --- Запуск готового образа через docker compose (не используются npm start) ---
# Суффикс имени контейнера: ok-service-frontend-local.
CONFIG_NAME=local

# Тег образа gloomylime/ok-service-frontend; укажите нужный опубликованный тег.
TAG=latest

# Порт на хосте: 127.0.0.1:8080 -> порт 3000 внутри контейнера.
# На порт dev-сервера Webpack (8083) эта настройка не влияет.
PORT=8080
